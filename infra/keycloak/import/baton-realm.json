{
  "realm": "baton",
  "displayName": "Baton",
  "displayNameHtml": "<strong>Baton</strong>",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "rememberMe": true,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Chats with the Baton assistant and sees only their own conversations."
      },
      {
        "name": "agent",
        "description": "Works the support desk: accepts handoffs, replies, resolves."
      },
      {
        "name": "admin",
        "description": "Manages agents and handoff policy; sees every conversation and insights."
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-baton",
    "description": "Roles every new user gets",
    "composite": true,
    "composites": {
      "realm": [
        "offline_access",
        "uma_authorization",
        "customer"
      ]
    }
  },
  "clients": [
    {
      "clientId": "baton-web",
      "name": "Baton web app",
      "description": "The React app (customer chat, agent desk, admin). Public client: authorization code + PKCE.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "${BATON_WEB_URL}",
      "baseUrl": "/",
      "redirectUris": [
        "${BATON_WEB_URL}/*"
      ],
      "webOrigins": [
        "${BATON_WEB_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${BATON_WEB_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "baton-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "baton-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "baton-api",
      "name": "Baton API",
      "description": "Resource server: never signs anyone in, only names the audience of access tokens.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
