    {
      "type": "timeseries",
      "title": "Live answer quality (LLM judge, 1h average)",
      "description": "Sampled live answers scored by the judge model. Faithfulness = share of claims supported by the retrieved sources. Drill into low scores in Langfuse.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (metric) (rate(online_eval_score_sum[1h])) / sum by (metric) (rate(online_eval_score_count[1h]))",
          "legendFormat": "{{metric}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
