    {
      "type": "stat",
      "title": "Handoff rate (1h)",
      "description": "Share of real questions passed to a person. Some handoffs are correct (sensitive topics, requests for a person), so watch the trend and the reasons.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(rag_bot_turns_total{outcome=\"handed_off\"}[1h])) / sum(increase(rag_bot_turns_total{outcome!=\"small_talk\"}[1h]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.35,
                "color": "yellow"
              },
              {
                "value": 0.5,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
