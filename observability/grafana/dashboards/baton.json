{
  "uid": "baton",
  "title": "Baton — bot, handoff and LLM",
  "tags": [
    "support",
    "rag",
    "handoff"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
