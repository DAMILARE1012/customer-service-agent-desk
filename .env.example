# Copy to `.env` and fill in. `.env` is git-ignored; this template is committed.
# Vite reloads the dev server automatically when this file changes.

# ═════════════════════════════════════════════════════════════════════════════
# SIGN-IN ACCOUNTS — every login in one place. `npm run accounts` prints them with their URLs.
# ═════════════════════════════════════════════════════════════════════════════

# Staff web app (http://localhost:5173) — agent desk and admin, demo staff imported into Keycloak, one shared password:
#   agents     alex.rivera · priya.shah
#   admin      jade.kim (also an agent)
# Customers never sign in: they use the chat widget on your website (demo: http://localhost:5173/demo-store).
# Used only when Keycloak first imports the realm; change it later in the Keycloak admin console.
BATON_DEMO_PASSWORD=change-me

# Keycloak admin console (http://localhost:8080/admin) — manage users and roles; not a Baton user.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Langfuse (http://localhost:3000) — traces, scores, evaluation runs.
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=change-me

# Grafana (http://localhost:3001) — monitoring dashboard.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ═════════════════════════════════════════════════════════════════════════════
# FRONTEND — variables prefixed with VITE_ are bundled into the browser.
# Anyone using the app can read them. NEVER put API keys or secrets here.
# ═════════════════════════════════════════════════════════════════════════════

# Backend base URL. Leave empty to use the in-browser mock backend.
VITE_API_URL=

# Sign-in with Keycloak (npm run infra:up starts it). Leave VITE_KEYCLOAK_URL empty to use the
# demo persona picker instead — only valid with the mock backend (VITE_API_URL empty).
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=baton
VITE_KEYCLOAK_CLIENT_ID=baton-web

# How often the desk refreshes the queue and open conversation (ms).
VITE_POLLING_INTERVAL_MS=4000

# Simulated network latency for the mock backend (ms).
VITE_MOCK_LATENCY_MIN_MS=150
VITE_MOCK_LATENCY_MAX_MS=450

# ── Handoff policy: when the bot steps aside ─────────────────────────────────
# Retrieval score (0–1) the bot needs before answering on its own.
VITE_HANDOFF_ANSWER_THRESHOLD=0.5
# Below this score (0–1) the knowledge base doesn't cover the question.
VITE_HANDOFF_NO_MATCH_THRESHOLD=0.25
# ...but only hand off on "no match" if the question had at least this many meaningful words.
VITE_HANDOFF_MIN_TERMS_FOR_NO_MATCH=4
# Consecutive turns without a confident answer before the bot gives up.
VITE_HANDOFF_MAX_FAILED_ATTEMPTS=2
# Sentiment (-1 to 1) at or below which the customer counts as frustrated.
VITE_HANDOFF_SENTIMENT_THRESHOLD=-0.5
# Minimum score (0–1) for the copilot to suggest a draft reply to the agent.
VITE_HANDOFF_COPILOT_THRESHOLD=0.45

# ── Handoff SLA: queue wait-time colouring (seconds) ─────────────────────────
VITE_HANDOFF_SLA_WARN_SECONDS=120
VITE_HANDOFF_SLA_BREACH_SECONDS=300

# ═════════════════════════════════════════════════════════════════════════════
# BACKEND — no VITE_ prefix, so Vite never exposes these to the browser.
# Read by the FastAPI backend (backend/); never by the frontend.
# ═════════════════════════════════════════════════════════════════════════════

SERVER_PORT=8787

# Groq (OpenAI-compatible API). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Your key must have access to this model: GET $GROQ_BASE_URL/models lists what it can use.
# On-demand keys may not include Llama 3.x (now Enterprise); openai/gpt-oss-20b is the small, fast alternative.
GROQ_MODEL=openai/gpt-oss-20b

# Generation settings. Keep temperature low for grounded, repeatable support answers.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2
# Reasoning models only (openai/gpt-oss-*): low | medium | high. Their reasoning counts toward
# LLM_MAX_TOKENS, so use 1024+ with them. Leave empty for Llama-style models.
LLM_REASONING_EFFORT=low
# USD per million tokens [input, output], for the cost metrics. Verify against your Groq console:
# the Groq models page now lists Llama 3.x under Enterprise pricing.
LLM_PRICES_PER_MILLION={"openai/gpt-oss-20b":[0.075,0.3],"llama-3.1-8b-instant":[0.05,0.08],"openai/gpt-oss-120b":[0.15,0.6]}

# LLM-as-judge for evaluation (same Groq key). Deliberately a stronger model from another family,
# so the answering model never grades itself.
JUDGE_MODEL=openai/gpt-oss-120b
JUDGE_REASONING_EFFORT=medium
JUDGE_MAX_TOKENS=4096
# On Groq's on-demand tier gpt-oss-120b allows 8,000 tokens/minute (~2–3 judgments), so judgments
# queue and wait out 429s rather than fail. Raise the concurrency only on a higher tier.
JUDGE_CONCURRENCY=1
JUDGE_MAX_RETRIES=6

# ── Answer policy for the real backend (cosine similarities, calibrated with `uv run baton-eval`) ──
# Below this retrieval confidence the question is treated as outside the knowledge base (no LLM call).
RAG_NO_MATCH_THRESHOLD=0.70
# Chunks given to the LLM as sources.
RAG_CONTEXT_CHUNKS=5
RAG_MAX_FAILED_ATTEMPTS=2
RAG_SENTIMENT_THRESHOLD=-0.5
# Minimum similarity for suggesting an internal agent procedure in the handoff brief.
RAG_PROCEDURE_THRESHOLD=0.72
# Origin allowed to call the API from a browser (* for local development).
CORS_ORIGIN=*

# ── Support sessions: a conversation ends, and never reopens ─────────────────
# Bot or agent chat with no new message for this long → closed as inactive.
SESSION_IDLE_MINUTES=30
# A customer waiting for an agent whose chat window has been closed this long → closed as abandoned.
SESSION_ABANDON_MINUTES=10
# How often idle sessions are checked.
SESSION_SWEEP_SECONDS=60

# ── Data rules and the review pipeline ──────────────────────────────────────
# Closed conversations lose their text (and Langfuse traces) after this many days; 0 keeps them.
RETENTION_DAYS=365
# How often closed sessions are reviewed for knowledge gaps and test questions; 0 = only on demand.
REVIEW_INTERVAL_MINUTES=60
# Shown in the customer chat. Empty = a notice built from RETENTION_DAYS.
PRIVACY_NOTICE=

# ── Customer chat widget: customers never sign in to Baton ──────────────────
# Signs the widget's session tokens. The widget is off until this is set.
WIDGET_SIGNING_SECRET=change-me
# Shared with your website's backend, which signs short-lived identity tokens for customers already
# signed in to your site (HS256: sub = your user id, plus email, name, exp ≤ 24 h). Guests need none.
WIDGET_IDENTITY_SECRET=change-me
# Local demo only: lets the demo store ask the API to sign identity tokens for seeded customers.
WIDGET_DEMO_IDENTITY=false
# Session length: anonymous visitors (days), customers your website identified (hours).
WIDGET_VISITOR_DAYS=30
WIDGET_IDENTIFIED_HOURS=12
# Abuse protection for the public widget.
WIDGET_MESSAGES_PER_MINUTE=12
WIDGET_SESSIONS_PER_HOUR=30

# ── Identity: Keycloak (npm run infra:up → http://localhost:8080) ────────────
# The API accepts only access tokens issued by this realm for the baton-api audience.
KEYCLOAK_URL=http://localhost:8080
# How the API itself reaches Keycloak (signing keys). Inside Docker: http://keycloak:8080.
KEYCLOAK_INTERNAL_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=baton
KEYCLOAK_AUDIENCE=baton-api
KEYCLOAK_PORT=8080
KEYCLOAK_DB_PASSWORD=change-me
# Where the web app runs; Keycloak only redirects back to this origin.
BATON_WEB_URL=http://localhost:5173
# Service account the API uses to delete a person's Keycloak account when an admin erases their data.
KEYCLOAK_ADMIN_CLIENT_ID=baton-api-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

# ── App database: users (customers, agents, admins), conversations, settings ──
BATON_DB_PASSWORD=change-me
BATON_DB_PORT=5433
# Empty = in-memory store (tests, quick experiments): nothing survives a restart.
# 127.0.0.1, not localhost: on Windows, Docker publishes IPv4 only and libpq tries ::1 first and hangs.
DATABASE_URL=postgresql://baton:change-me@127.0.0.1:5433/baton
# Demo customers and agents. Agents are claimed by their Keycloak users on first sign-in; customers by the website's identity token (same id or email).
SEED_DEMO_DATA=true

# Links shown in the admin area.
GRAFANA_URL=http://localhost:3001

# ── Langfuse: traces and evaluation (npm run obs:up starts it on http://localhost:3000) ──
# The same keys are used to create the project on first start, so no manual setup is needed.
LANGFUSE_PUBLIC_KEY=change-me
LANGFUSE_SECRET_KEY=change-me
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENVIRONMENT=development
# Share of live bot answers scored by the judge (faithfulness, relevance). 0 turns it off.
ONLINE_EVAL_SAMPLE_RATE=0.2

# End-to-end evaluation (uv run baton-eval-rag)
EVAL_RAG_DATASET=baton-eval
# WixQA questions per run (off-topic questions are added at a fifth of this).
EVAL_RAG_LIMIT=50
EVAL_RAG_CONCURRENCY=2

# ── Observability stack secrets (docker compose; local only) ──────────────────
LANGFUSE_INIT_ORG_ID=baton
LANGFUSE_INIT_PROJECT_ID=baton-assistant
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
# 64 hex characters.
LANGFUSE_ENCRYPTION_KEY=change-me
LANGFUSE_POSTGRES_PASSWORD=change-me
LANGFUSE_CLICKHOUSE_PASSWORD=change-me
LANGFUSE_REDIS_PASSWORD=change-me
LANGFUSE_MINIO_PASSWORD=change-me
GRAFANA_PORT=3001
PROMETHEUS_PORT=9092

# ── Embeddings: computed locally with sentence-transformers (no API key, no rate limits) ──
# Groq has no embeddings endpoint. Model files download to DATA_DIR/models on first use
# (about 130 MB). Changing the model re-embeds everything.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Instruction prepended to search queries only (a BGE convention). Leave empty for models without one.
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:
EMBEDDING_BATCH_SIZE=32

# ── Knowledge ingestion (uv run baton-ingest) ─────────────────────────────────
# Sources to index, in priority order: when two contain identical text, the first one keeps it.
#   local = Markdown files in CONTENT_DIR (your own help centre and policies)
#   wixqa = Wix help centre, 6,221 articles (public benchmark data)
#   abcd  = agent procedures, used for agents only, never shown to customers
INGEST_SOURCES=local,wixqa,abcd
CONTENT_DIR=content
# Downloads, model weights and the built index (git-ignored).
DATA_DIR=data

# Freshness: minutes between upstream checks per source (0 = check on every run).
# A check is cheap (a file hash or an HTTP HEAD); data is only downloaded and re-embedded if it changed.
SOURCE_LOCAL_REFRESH_MINUTES=0
SOURCE_WIXQA_REFRESH_MINUTES=10080
SOURCE_ABCD_REFRESH_MINUTES=10080

# Chunk sizes in model tokens. The model reads at most 512 tokens, including the title line.
CHUNK_MIN_TOKENS=50
CHUNK_TARGET_TOKENS=300
CHUNK_MAX_TOKENS=450

# ── Retrieval ────────────────────────────────────────────────────────────────
# Chunks returned per search.
RETRIEVAL_TOP_K=5
# Candidates taken from each of vector search and keyword search before they are combined.
RETRIEVAL_CANDIDATES=50
# Reciprocal rank fusion constant: higher values blend the two rankings more evenly.
RETRIEVAL_RRF_K=60
# Cross-encoder that reorders the top RERANK_CANDIDATES hybrid results (runs locally on CPU).
# Empty = off. Measure with `uv run baton-eval` before turning it on; see README for results.
RERANKER_MODEL=
RERANK_CANDIDATES=20

# ── Evaluation (uv run baton-eval): targets used to suggest handoff thresholds ─
# Of the questions the bot answers on its own, at least this share must have the right article in its top 3.
EVAL_ANSWER_PRECISION=0.8
# The same, for copilot drafts shown to agents (they review drafts, so the bar is lower).
EVAL_COPILOT_PRECISION=0.6
# At most this share of real questions may fall below the "no match" threshold.
EVAL_NO_MATCH_MAX_MISS_RATE=0.05
