{
  "name": "rag-agent-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "ingest": "node server/ingest/cli.js",
    "search": "node server/rag/cli.js",
    "eval": "node server/eval/cli.js",
    "test": "node --test \"server/**/*.test.js\"",
    "server": "node server/api/server.js",
    "eval:rag": "node server/eval/rag-cli.js",
    "obs:up": "docker compose --env-file .env -f observability/docker-compose.yml up -d",
    "obs:down": "docker compose --env-file .env -f observability/docker-compose.yml down",
    "obs:ps": "docker compose --env-file .env -f observability/docker-compose.yml ps",
    "obs:logs": "docker compose --env-file .env -f observability/docker-compose.yml logs -f --tail=100"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@langfuse/client": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@reduxjs/toolkit": "^2.13.0",
    "node-html-parser": "^9.0.4",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
