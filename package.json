{
  "name": "baton",
  "private": true,
  "description": "Baton — shortcuts for the whole project. The app lives in frontend/ (React) and backend/ (FastAPI).",
  "scripts": {
    "accounts": "node scripts/accounts.mjs",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "api": "cd backend && uv run baton-api",
    "ingest": "cd backend && uv run baton-ingest",
    "eval": "cd backend && uv run baton-eval",
    "eval:rag": "cd backend && uv run baton-eval-rag",
    "test": "cd backend && uv run pytest",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:ps": "docker compose --env-file .env -f infra/docker-compose.yml ps",
    "infra:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f --tail=100",
    "app:up": "docker compose --env-file .env -f infra/docker-compose.yml --profile app up -d --build",
    "app:down": "docker compose --env-file .env -f infra/docker-compose.yml --profile app down",
    "app:logs": "docker compose --env-file .env -f infra/docker-compose.yml --profile app logs -f --tail=100 api web",
    "app:ingest": "docker compose --env-file .env -f infra/docker-compose.yml --profile tools run --rm ingest",
    "obs:up": "docker compose --env-file .env -f observability/docker-compose.yml up -d",
    "obs:down": "docker compose --env-file .env -f observability/docker-compose.yml down",
    "obs:ps": "docker compose --env-file .env -f observability/docker-compose.yml ps",
    "obs:logs": "docker compose --env-file .env -f observability/docker-compose.yml logs -f --tail=100"
  }
}
